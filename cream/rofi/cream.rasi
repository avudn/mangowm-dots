* {
    font:   "Libertinus Mono 14";

        bg0     : #FFF8F0;  /* cream — base */
    bg1     : #F5EEE0;  /* cream, slightly darkened */
    bg2     : #FFCF99;  /* peach — base */
    bg3     : #111D4A;  /* navy — base */
    fg0     : #1E1E24;  /* charcoal — base */
    fg1     : #3A3A42;  /* charcoal, lightened */
    fg2     : #EDE0D0;  /* cream, darkened */
    red     : #92140C;  /* red — base */
    green    : #0A1230;  /* navy, darkened (stand-in) */
    yellow  : #D9A055;  /* peach, darkened */
    blue    : #111D4A;  /* navy — base */
    magenta : #C41D12;  /* red, lightened (stand-in) */
    cyan    : #2C3F7A;  /* navy, lightened (stand-in) */
    accent: @magenta;
    urgent: @red;
    background-color : transparent;
    text-color       : @bg3; 

  margin  : 0;
  padding : 0;
  spacing : 0;
}

element-icon, element-text, scrollbar {
  cursor: pointer;
}

window {
  location : center;
  width    : 380px;
  x-offset : 4px;
  y-offset : 26px;

  background-color: @bg0;
  border: 6px;
  border-color: @bg3;
  border-radius: 0px;
}

inputbar {
  spacing  : 8px;
  padding  : 4px 8px;
  children : [ icon-search, entry ];

  background-color: @bg0;
}

icon-search, entry, element-icon, element-text {
  vertical-align: 0.5;
}

icon-search {
  expand   : false;
  filename : "search-symbolic";
  size     : 14px;
}

textbox {
  padding          : 4px 8px;
  background-color : @bg1;
}

listview {
  padding      : 4px 0px;
  lines        : 12;
  columns      : 1;
  scrollbar    : true;
  fixed-height : false;
  dynamic      : true;
}

element {
  padding : 4px 8px;
  spacing : 8px;
}

element normal urgent {
  text-color: @urgent;
}

element normal active {
  text-color: @accent;
}

element alternate active {
  text-color: @accent;
}

element selected {
  text-color       : @bg1;
  background-color : @accent;
}

element selected urgent {
  background-color: @urgent;
}

element-icon {
  size: 0.8em;
}

element-text {
  text-color: @green;
}

scrollbar {
  handle-width : 0px;
  handle-color : @bg0;
  padding      : 0 4px;
}
